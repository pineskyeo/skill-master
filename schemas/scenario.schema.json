{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent scenario v2 (scenarios/*.json)",
  "description": "One agent scenario, v2 (unit B1): id, turns and must_include as in v1; expected_tools is a non-empty list of capabilities from the AGENT.md v2 vocabulary; expected_outcome is a non-empty list of typed criterion objects; success_criteria is optional and, when present, a non-empty list of typed criterion objects. Unit K2: fixture is optional and names the folder agents/<name>/fixtures/<fixture>/ that a run copies into the sandbox work folder. A v1 scenario (tool names, string outcomes) fails. A $defs entry with a description is a message rule. Fix: write each scenario as a JSON object with id (string), turns ([{\"user\": ...}]), expected_tools (capabilities such as read or search), must_include (list of strings), and expected_outcome (typed criterion objects such as {\"type\": \"no_writes\"}).",
  "$comment": "source: house (scenario v2, assessment section 2.1 line 154 and section 4.4 line 358, agent-master-skills.md:149, plan.md:778; no dated record); severity: fail (the scenarios-valid row, must); protects: claude, codex, opencode, hermes. The criterion definitions are copied from schemas/agent-frontmatter.schema.json and pinned equal by tests/test_typed_criteria.py.",
  "$ref": "#/$defs/scenario",
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "nonblank-list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}},
    "count": {"type": "integer", "minimum": 1},
    "capability": {"enum": ["read", "search", "write", "shell", "web_fetch", "web_search", "delegate", "skill"]},
    "regex": {"type": "string", "minLength": 1, "x-python-regex": true},
    "work-path": {"type": "string", "minLength": 1, "not": {"anyOf": [{"pattern": "^/"}, {"pattern": "\\\\"}, {"pattern": "\\u0000"}, {"pattern": "(?:^|/)\\.\\.(?:/|\\Z)"}]}},
    "criterion": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"enum": ["min_verified_sources", "file_line_citations", "no_writes", "max_chars", "markdown_table", "llm", "command_ran", "command_absent", "file_exists"]}},
      "allOf": [
        {"if": {"required": ["type"], "properties": {"type": {"const": "min_verified_sources"}}}, "then": {"$ref": "#/$defs/min_verified_sources"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "file_line_citations"}}}, "then": {"$ref": "#/$defs/file_line_citations"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "no_writes"}}}, "then": {"$ref": "#/$defs/no_writes"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "max_chars"}}}, "then": {"$ref": "#/$defs/max_chars"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "markdown_table"}}}, "then": {"$ref": "#/$defs/markdown_table"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "llm"}}}, "then": {"$ref": "#/$defs/llm"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "command_ran"}}}, "then": {"$ref": "#/$defs/command_ran"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "command_absent"}}}, "then": {"$ref": "#/$defs/command_absent"}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "file_exists"}}}, "then": {"$ref": "#/$defs/file_exists"}}
      ]
    },
    "min_verified_sources": {"required": ["type", "min"], "additionalProperties": false, "properties": {"type": true, "min": {"$ref": "#/$defs/count"}}},
    "file_line_citations": {"required": ["type", "min"], "additionalProperties": false, "properties": {"type": true, "min": {"$ref": "#/$defs/count"}}},
    "no_writes": {"required": ["type"], "additionalProperties": false, "properties": {"type": true}},
    "max_chars": {"required": ["type", "max"], "additionalProperties": false, "properties": {"type": true, "max": {"$ref": "#/$defs/count"}}},
    "markdown_table": {"required": ["type"], "additionalProperties": false, "properties": {"type": true}},
    "llm": {"required": ["type", "text"], "additionalProperties": false, "properties": {"type": true, "text": {"$ref": "#/$defs/nonblank"}}},
    "command_ran": {"required": ["type", "regex"], "additionalProperties": false, "properties": {"type": true, "regex": {"$ref": "#/$defs/regex"}}},
    "command_absent": {"required": ["type", "regex"], "additionalProperties": false, "properties": {"type": true, "regex": {"$ref": "#/$defs/regex"}}},
    "file_exists": {"required": ["type", "path"], "additionalProperties": false, "properties": {"type": true, "path": {"$ref": "#/$defs/work-path"}}},
    "scenario": {
      "if": {"$ref": "#/$defs/scenario-object"},
      "then": {"allOf": [
        {"$ref": "#/$defs/id"},
        {"$ref": "#/$defs/turns"},
        {"$ref": "#/$defs/expected-tools"},
        {"$ref": "#/$defs/must-include"},
        {"$ref": "#/$defs/expected-outcome"},
        {"$ref": "#/$defs/success-criteria"},
        {"$ref": "#/$defs/fixture"}
      ]},
      "else": {"$ref": "#/$defs/scenario-object"}
    },
    "scenario-object": {"description": "scenario must be a JSON object, got %(type)s", "type": "object"},
    "id": {"description": "id: non-empty string required", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/nonblank"}}},
    "turns": {
      "description": "turns: non-empty list of {\"user\": \"<text>\"} required",
      "required": ["turns"],
      "properties": {"turns": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["user"], "properties": {"user": {"$ref": "#/$defs/nonblank"}}}}}
    },
    "expected-tools": {
      "description": "expected_tools: non-empty list of capabilities (read, search, write, shell, web_fetch, web_search, delegate, skill) required",
      "required": ["expected_tools"],
      "properties": {"expected_tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}}}
    },
    "must-include": {"description": "must_include: non-empty list of strings required", "required": ["must_include"], "properties": {"must_include": {"$ref": "#/$defs/nonblank-list"}}},
    "expected-outcome": {
      "if": {"$ref": "#/$defs/expected-outcome-list"},
      "then": {"properties": {"expected_outcome": {"items": {"$ref": "#/$defs/outcome-item"}}}},
      "else": {"$ref": "#/$defs/expected-outcome-list"}
    },
    "expected-outcome-list": {
      "description": "expected_outcome: non-empty list of typed criterion objects required",
      "required": ["expected_outcome"],
      "properties": {"expected_outcome": {"type": "array", "minItems": 1}}
    },
    "fixture": {
      "description": "fixture: the name of one folder under the agent's fixtures/ folder required (^[a-z0-9][a-z0-9_-]{0,63}$; no dot, slash or backslash)",
      "properties": {"fixture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}\\Z"}}
    },
    "outcome-item": {
      "description": "expected_outcome[%(i)s]: %(error)s (a criterion is one typed object: min_verified_sources, file_line_citations, no_writes, max_chars, markdown_table, llm, command_ran, command_absent or file_exists)",
      "$ref": "#/$defs/criterion"
    },
    "success-criteria": {
      "if": {"$ref": "#/$defs/success-criteria-list"},
      "then": {"properties": {"success_criteria": {"items": {"$ref": "#/$defs/criteria-item"}}}},
      "else": {"$ref": "#/$defs/success-criteria-list"}
    },
    "success-criteria-list": {
      "description": "success_criteria: non-empty list of typed criterion objects required when present",
      "properties": {"success_criteria": {"type": "array", "minItems": 1}}
    },
    "criteria-item": {
      "description": "success_criteria[%(i)s]: %(error)s (a criterion is one typed object: min_verified_sources, file_line_citations, no_writes, max_chars, markdown_table, llm, command_ran, command_absent or file_exists)",
      "$ref": "#/$defs/criterion"
    }
  }
}
