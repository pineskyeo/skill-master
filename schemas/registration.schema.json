{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registration.json",
  "description": "The record skill_eval.register writes: skill_eval.registration_record plus the register signature under signed. approval is auto (a clean gate) or the signed registration approval. Every hash is 64 lower hex; ruleset_sha256 is the rule bundle hash at registration (plan.md:844).",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_name", "skill_path", "iteration", "benchmark_sha256", "skill_sha256", "eval_set_sha256",
               "skill_md_sha256", "ruleset_sha256", "registered_at", "approval"],
  "properties": {
    "skill_name": {"type": "string", "minLength": 1},
    "skill_path": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "benchmark_sha256": {"$ref": "#/$defs/sha256"},
    "skill_sha256": {"$ref": "#/$defs/sha256"},
    "eval_set_sha256": {"$ref": "#/$defs/sha256"},
    "skill_md_sha256": {"$ref": "#/$defs/sha256"},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "registered_at": {"$ref": "#/$defs/at"},
    "approval": {"oneOf": [{"const": "auto"}, {"$ref": "#/$defs/signed"}]},
    "signed": {"$ref": "#/$defs/signed"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}\\Z"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\\Z"},
    "signed": {
      "description": "A signed record of engine/approvals.py (Approver.sign).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "method", "sha256", "ruleset_sha256", "principal", "at", "signature"],
      "properties": {
        "format": {"const": 1},
        "method": {"const": "ssh-sig"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "ruleset_sha256": {"$ref": "#/$defs/sha256"},
        "principal": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}\\Z"},
        "at": {"$ref": "#/$defs/at"},
        "signature": {"type": "string",
                      "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?\\Z"}
      }
    }
  }
}
