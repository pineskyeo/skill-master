{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registration.json",
  "description": "Format 2 of the record skill_eval.register writes (unit B5): skill_eval.registration_record plus the register signature under signed. skill_path is the POSIX path from the folder that holds registration.json to the skill folder. version is the SemVer 2.0.0 version of SKILL.md. approvals copies each signed approvals.json record the registration relied on: registration when the gate needed approval, and each coverage_waiver:<tool> that counted. approval is auto (a clean gate) or the signed registration approval. The register signature covers every field but signed (skill_eval.REGISTRATION_SIGNED). Every hash is 64 lower hex; ruleset_sha256 is the rule bundle hash at registration (plan.md:844). Unit B6 (D7): kind agent is an AGENT.md v2 agent; its skill_path names the agent folder, skill_sha256 its tree hash, eval_set_sha256 the hash of its scenarios/*.json, skill_md_sha256 the hash of AGENT.md and version the AGENT.md version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registration_format", "kind", "skill_name", "version", "skill_path", "iteration", "benchmark_sha256",
               "skill_sha256", "eval_set_sha256", "skill_md_sha256", "ruleset_sha256", "approvals", "registered_at",
               "approval"],
  "properties": {
    "registration_format": {"const": 2},
    "kind": {"enum": ["skill", "agent"]},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\Z"},
    "version": {"$ref": "#/$defs/semver"},
    "skill_path": {"type": "string", "pattern": "^[^/~\\\\][^\\\\]*\\Z"},
    "iteration": {"type": "integer", "minimum": 1},
    "benchmark_sha256": {"$ref": "#/$defs/sha256"},
    "skill_sha256": {"$ref": "#/$defs/sha256"},
    "eval_set_sha256": {"$ref": "#/$defs/sha256"},
    "skill_md_sha256": {"$ref": "#/$defs/sha256"},
    "ruleset_sha256": {"$ref": "#/$defs/sha256"},
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registration": {"$ref": "#/$defs/signed"},
        "coverage_waiver:claude": {"$ref": "#/$defs/waiver"},
        "coverage_waiver:codex": {"$ref": "#/$defs/waiver"},
        "coverage_waiver:opencode": {"$ref": "#/$defs/waiver"},
        "coverage_waiver:hermes": {"$ref": "#/$defs/waiver"}
      }
    },
    "registered_at": {"$ref": "#/$defs/at"},
    "machine_waiver": {
      "description": "Unit S1: present only when this Mac's machine waiver cleared a coverage_required tool; sha256 is approvals.machine_waiver_sha256 of record, the whole signed record of schemas/machine-waiver.schema.json. The register signature covers this field when it is present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "record"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "method", "machine_id", "tools", "expires", "reason", "principal", "at", "signature"],
          "properties": {
            "format": {"const": 1},
            "method": {"const": "ssh-sig"},
            "machine_id": {"type": "string", "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\Z"},
            "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["opencode", "hermes"]}},
            "expires": {"$ref": "#/$defs/at"},
            "reason": {"type": "string", "pattern": "^[!-~]([ -~]{0,198}[!-~])?\\Z"},
            "principal": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}\\Z"},
            "at": {"$ref": "#/$defs/at"},
            "signature": {"type": "string",
                          "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?\\Z"}
          }
        }
      }
    },
    "approval": {"oneOf": [{"const": "auto"}, {"$ref": "#/$defs/signed"}]},
    "signed": {"$ref": "#/$defs/signed"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}\\Z"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\\Z"},
    "semver": {
      "description": "SemVer 2.0.0: MAJOR.MINOR.PATCH, an optional -PRERELEASE and +BUILD, no leading zeros, no v (engine/registry.py SEMVER_RE).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?\\Z"
    },
    "signed": {
      "description": "A signed record of engine/approvals.py (Approver.sign).",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "method", "sha256", "ruleset_sha256", "principal", "at", "signature"],
      "properties": {
        "format": {"const": 1},
        "method": {"const": "ssh-sig"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "ruleset_sha256": {"$ref": "#/$defs/sha256"},
        "principal": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}\\Z"},
        "at": {"$ref": "#/$defs/at"},
        "signature": {"type": "string",
                      "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?\\Z"}
      }
    },
    "waiver": {
      "description": "A signed coverage_waiver:<tool> record: the signed fields plus the reason typed at the terminal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "method", "sha256", "ruleset_sha256", "principal", "at", "signature", "reason"],
      "properties": {
        "format": {"const": 1},
        "method": {"const": "ssh-sig"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "ruleset_sha256": {"$ref": "#/$defs/sha256"},
        "principal": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,63}\\Z"},
        "at": {"$ref": "#/$defs/at"},
        "signature": {"type": "string",
                      "pattern": "^-----BEGIN SSH SIGNATURE-----\\n[A-Za-z0-9+/=\\n]+-----END SSH SIGNATURE-----\\n?\\Z"},
        "reason": {"type": "string", "pattern": "^[!-~]([ -~]{0,198}[!-~])?\\Z"}
      }
    }
  }
}
